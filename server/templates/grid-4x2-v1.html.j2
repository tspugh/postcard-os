<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  /* 6x4in nominal postcard, 4x2 slot grid, fixed margins/gutter (TRD §5) */
  body { margin: 0; font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; background: #f5f5f4; }
  .card { width: 900px; height: 600px; margin: 16px auto; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.15);
          display: flex; flex-direction: column; box-sizing: border-box; padding: 18px; }
  .header { text-align: center; font-size: 22px; font-weight: 700; letter-spacing: .04em;
            text-transform: uppercase; padding-bottom: 12px; }
  .grid { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 1fr);
          gap: 12px; }
  .slot { border: 2px solid #d6d3d1; border-radius: 6px; padding: 10px; display: flex; flex-direction: column;
          justify-content: space-between; overflow: hidden; box-sizing: border-box; }
  .slot.empty { border-style: dashed; align-items: center; justify-content: center; color: #a8a29e; }
  .slot .logo { max-height: 56px; max-width: 100%; object-fit: contain; align-self: flex-start; }
  .slot .headline { font-size: 16px; font-weight: 700; line-height: 1.2; }
  .slot .offer { font-size: 13px; line-height: 1.3; }
  .slot .contact { font-size: 12px; color: #57534e; }
  .slot .num { font-size: 10px; color: #d6d3d1; align-self: flex-end; }
</style>
</head>
<body>
<div class="card">
  <div class="header">{{ header }}</div>
  <div class="grid">
    {% for cell in cells %}
    {% if cell.empty %}
    <div class="slot empty">
      <div>
        <div class="headline" style="color:#a8a29e">{{ cell.category_label }}</div>
        <div class="offer">this space available</div>
      </div>
      <div class="num">{{ cell.slot }}</div>
    </div>
    {% else %}
    <div class="slot" style="border-color: {{ cell.accent_color or '#d6d3d1' }}">
      {% if cell.logo_url %}<img class="logo" src="{{ cell.logo_url }}" alt="">{% endif %}
      <div class="headline">{{ cell.headline }}</div>
      <div class="offer">{% if cell.offer_html %}{{ cell.offer_html | safe }}{% else %}{{ cell.offer_text }}{% endif %}</div>
      <div class="contact">{{ cell.contact_line }}</div>
      <div class="num">{{ cell.slot }}</div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
</div>
</body>
</html>
